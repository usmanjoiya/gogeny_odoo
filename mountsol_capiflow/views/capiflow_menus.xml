<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Capiflow main menu -->
    <menuitem id="menu_capiflow_root"
              name="Capiflow"
              web_icon="mountsol_capiflow,static/description/icon.png"
              sequence="50"/>

    <menuitem id="menu_capiflow_bundles"
              name="Bundles"
              parent="menu_capiflow_root"
              action="action_capiflow_bundle"
              sequence="10"/>

    <menuitem id="menu_capiflow_config"
              name="Configuration"
              parent="menu_capiflow_root"
              sequence="90"
              groups="account.group_account_manager"/>

    <menuitem id="menu_capiflow_settings"
              name="Settings"
              parent="menu_capiflow_config"
              action="account.action_account_config"
              sequence="10"/>
</odoo>
