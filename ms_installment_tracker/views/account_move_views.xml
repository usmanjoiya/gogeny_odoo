<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_installment_tracker" model="ir.ui.view">
        <field name="name">account.move.form.installment.tracker</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='invoice_tab']" position="before">
                <page id="installment_tracker_tab" string="Installments"
                      invisible="move_type == 'entry'">
                    <widget name="installment_tracker"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
