<odoo>
    <template id="portal_invoice_payment_custom_amount" inherit_id="account_payment.portal_invoice_payment" name="Invoice Payment - Custom Amount">
        <xpath expr="//div[@id='o_payment_tabs']" position="attributes">
            <attribute name="class">d-flex flex-wrap justify-content-center gap-2</attribute>
        </xpath>
        <xpath expr="//div[@id='o_payment_tabs']/button[2]" position="after">
            <button class="btn btn-outline-primary o_btn_payment_tab flex-fill text-center"
                id="o_payment_custom_tab"
                data-bs-toggle="pill"
                data-bs-target="#o_payment_custom"
                type="button"
                role="tab"
                aria-controls="o_payment_custom"
                aria-selected="false"
                style="min-width: 120px;">
                <strong>Custom Amount</strong><br/>
            </button>
        </xpath>

        <xpath expr="//div[@id='o_payment_full']" position="after">
            <div class="tab-pane my-3"
                id="o_payment_custom"
                role="tabpanel"
                aria-labelledby="o_payment_custom_tab"
                tabindex="0"
            >
                <div class="text-bg-light row row-cols-1 row-cols-md-2 mx-0 py-2 rounded">
                    <div class="col-12 mb-3">
                        <label for="o_payment_custom_amount_input" class="form-label">
                            Amount to Pay (<span t-field="currency.name"/>)
                        </label>
                        <input type="number"
                            id="o_payment_custom_amount_input"
                            class="form-control"
                            name="custom_amount"
                            t-att-max="amount_due"
                            t-att-value="next_amount_to_pay"
                            step="0.01"
                            required="required"
                        />
                        <small class="form-text text-muted">
                            Max amount due: <t t-out="amount_due" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </small>
                    </div>

                    <t t-call="payment.summary_item">
                        <t t-set="name" t-value="'reference_custom'"/>
                        <t t-set="label">Reference</t>
                        <t t-set="value" t-value="next_payment_reference"/>
                        <t t-set="include_separator" t-value="True"/>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>