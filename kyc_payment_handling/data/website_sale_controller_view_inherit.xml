<odoo>
    <data>
        <!--        Installments Cart-->
        <template inherit_id="website_sale.product" id="product_payment_terms_carousel" name="Payment Terms Carousel">
            <xpath expr="//section[@id='product_detail']" position="after">
                <hr class="my-4"/>
                <section class="s_comparisons pt48 o_colored_level pb96" data-vxml="001" data-vcss="001"
                         data-snippet="s_comparisons" data-name="Comparisons">
                    <div class="container">
                        <div class="row gap-4 gap-lg-0 o_grid_mode" data-row-count="12">
                            <div class="o_grid_item g-col-lg-11 g-height-4 col-lg-11"
                                 style="z-index: 1; grid-area: 1 / 2 / 5 / 13;">
                                <div class="mb-4">
                                    <h3>Competitive installment pricing</h3>
                                    <p>
                                        Looking to own the latest iPhone without the full upfront cost? All iPhones
                                        offered are <strong>TRDA certified</strong>, ensuring top quality and
                                        authenticity. We offer <strong>easy installment plans</strong> tailored to fit
                                        your budget. Best of all, the <strong>advance payment is collected only upon
                                        delivery</strong>, giving you peace of mind and flexibility. Choose the plan
                                        that suits you best and enjoy your new device with confidence!
                                    </p>
                                </div>
                            </div>
                        </div>
                        <!-- Carousel wrapper -->
                        <div id="paymentTermsCarousel" class="carousel slide" data-bs-ride="false">
                            <div class="carousel-inner">
                                <!-- Break payment_terms into chunks of 3 -->
                                <t t-set="chunks" t-value="[]"/>
                                <t t-foreach="range(0, len(payment_terms), 3)" t-as="i">
                                    <t t-set="chunks" t-value="chunks + [payment_terms[i:i+3]]"/>
                                </t>
                                <!-- Iterate over each chunk -->
                                <t t-foreach="enumerate(chunks)" t-as="chunk_data">
                                    <t t-set="chunk_index" t-value="chunk_data[0]"/>
                                    <t t-set="chunk" t-value="chunk_data[1]"/>
                                    <div t-att-class="'carousel-item' + (' active' if chunk_index == 0 else '')">
                                        <div class="row d-flex justify-content-center">
                                            <t t-foreach="chunk" t-as="term">
                                                <div class="col-12 col-sm-6 col-md-4 mb-3">
                                                    <div class="s_card card o_cc o_cc1 h-100 my-0 o_colored_level"
                                                         data-vxml="001" data-snippet="s_card" data-name="Card">
                                                        <div class="card-body">
                                                            <h5 class="card-title">
                                                                <span style="display: block; line-height: 1.2em; height: 3.6em; overflow: hidden;">
                                                                    <t t-esc="term.name"/>
                                                                </span>
                                                            </h5>
                                                            <span style="display: block; min-height: 1.5em;">
                                                                <t t-if="partner_payment_term and term.id == partner_payment_term">
                                                                    <t t-if="partner_project_state == 'recieved'">
                                                                        <span class="badge bg-info">
                                                                            Recieved
                                                                        </span>
                                                                    </t>
                                                                    <t t-if="partner_project_state == 'in_review'">
                                                                        <span class="badge bg-info">
                                                                            In Review
                                                                        </span>
                                                                    </t>
                                                                    <t t-if="partner_project_state == 'approved'">
                                                                        <span class="badge bg-info">
                                                                            Approved
                                                                        </span>
                                                                    </t>
                                                                    <t t-if="partner_project_state == 'contract_sent'">
                                                                        <span class="badge bg-info">
                                                                            Ready to Checkout
                                                                        </span>
                                                                    </t>
                                                                    <t t-if="partner_project_state == 'reject'">
                                                                        <span class="badge bg-info">
                                                                            Rejected
                                                                        </span>
                                                                    </t>
                                                                </t>
                                                            </span>
                                                            <div class="my-2">
                                                                <t t-set="line" t-value="term.line_ids[1:2]"/>
                                                                <t t-if="line">
                                                                    <!-- Calculate product total tax -->
                                                                    <t t-set="total_tax"
                                                                       t-value="sum(t.amount for t in product.taxes_id) if product.taxes_id else 0.0"/>
<!--                                                                    <t t-esc="', '.join(t.name for t in product.taxes_id if 'DB' not in (t.name or '').upper()) if product.taxes_id else ''"/>-->
                                                                    <!-- Base price + tax -->
                                                                    <t t-set="taxed_price"
                                                                       t-value="product_price + (product_price * total_tax / 100.0)"/>
                                                                    <!-- Check if this product is linked to the payment term -->
                                                                    <t t-if="product.id in term.product_ids.ids">
                                                                        <t t-set="installment"
                                                                           t-value="((taxed_price + term.installment_amount) / 100.0) * line.value_amount"/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <t t-set="installment"
                                                                           t-value="(taxed_price / 100.0) * line.value_amount"/>
                                                                    </t>
                                                                    <strong class="h2-fs">
                                                                        <t t-esc="'%.2f' % installment"/>
                                                                    </strong>
                                                                </t>
                                                                <span class="h4-fs">
                                                                    <strong>
                                                                        <t t-esc="currency_symbol"/>
                                                                    </strong>
                                                                </span>
                                                                <small class="text-muted o_default_snippet_text">/
                                                                    month
                                                                </small>
                                                            </div>
                                                            <p class="card-text small">
                                                                Ideal for newcomers. Essential features to kickstart
                                                                sales and marketing. Perfect for small teams.
                                                            </p>

                                                            <t t-if="term.id != partner_payment_term">
                                                                <p class="card-text small">
                                                                    <a aria-describedby="popover573039"
                                                                       data-scroll-zone-end="100"
                                                                       data-scroll-zone-start="0"
                                                                       style="border-width: 1px; border-style: solid; animation-delay: -0.114646s; border-color: rgb(30, 2, 4); visibility: visible;"
                                                                       class="w-100 mb-3 o_anim_fade_in o_animate o_animate_on_scroll btn btn-outline-custom text-o-color-1 bg-o-color-5 o_animating"
                                                                       t-att-href="'/apply/' + str(term.id) + '/' + str(product.id)">
                                                                        Start Now
                                                                    </a>
                                                                </p>
                                                            </t>
                                                            <t t-if="partner_payment_term and term.id == partner_payment_term">
                                                                <t t-if="partner_project_state == 'recieved' or partner_project_state == 'approved' or partner_project_state == 'in_review'">
                                                                    <p class="card-text small">
                                                                        <a aria-describedby="popover573039"
                                                                           data-scroll-zone-end="100"
                                                                           data-scroll-zone-start="0"
                                                                           style="border-width: 1px; border-style: solid; animation-delay: -0.114646s; border-color: rgb(30, 2, 4); visibility: visible;"
                                                                           class="w-100 mb-3 o_anim_fade_in o_animate o_animate_on_scroll btn btn-outline-custom text-o-color-1 bg-o-color-5 o_animating"
                                                                           t-att-href="'/shop/' + str(product.id)">
                                                                            Application Processing
                                                                        </a>
                                                                    </p>
                                                                </t>
                                                                <t t-if="partner_project_state == 'contract_sent'">
                                                                    <p class="card-text small">
                                                                        <a aria-describedby="popover573039"
                                                                           data-scroll-zone-end="100"
                                                                           data-scroll-zone-start="0"
                                                                           style="border-width: 1px; border-style: solid; animation-delay: -0.114646s; border-color: rgb(30, 2, 4); visibility: visible;"
                                                                           class="w-100 mb-3 o_anim_fade_in o_animate o_animate_on_scroll btn btn-outline-custom text-o-color-1 bg-o-color-5 o_animating"
                                                                           t-att-href="'/checkout/' + str(product.id) + '/' + str(partner_payment_term) + '/' + str(partner_line_id or 0)">
                                                                            Proceed to Checkout
                                                                        </a>
                                                                    </p>
                                                                </t>
                                                                <t t-if="partner_project_state == 'reject'">
                                                                    <p class="card-text small">
                                                                        <a aria-describedby="popover573039"
                                                                           data-scroll-zone-end="100"
                                                                           data-scroll-zone-start="0"
                                                                           style="border-width: 1px; border-style: solid; animation-delay: -0.114646s; border-color: rgb(30, 2, 4); visibility: visible;"
                                                                           class="w-100 mb-3 o_anim_fade_in o_animate o_animate_on_scroll btn btn-outline-custom text-o-color-1 bg-o-color-5 o_animating"
                                                                           t-att-href="'/apply/' + str(term.id) + '/' + str(product.id)">
                                                                            Submit Application Again
                                                                        </a>
                                                                    </p>
                                                                </t>
                                                            </t>

                                                            <ul class="list-group list-group-flush text-start">
                                                                <t t-if="product.id in term.product_ids.ids">
                                                                    <t t-set="total_inst_amount"
                                                                        t-value="taxed_price + term.installment_amount"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-set="total_inst_amount"
                                                                        t-value="taxed_price"/>
                                                                </t>
                                                                <!-- <li class="list-group-item px-0 bg-transparent text-reset">
                                                                    <i class="fa fa-check text-success" role="img"></i>
                                                                    &#160;On Installments Amount
                                                                    <t t-esc="'%.2f' % total_inst_amount"/>
                                                                    <t t-esc="currency_symbol"/>
                                                                </li> -->
                                                                <li class="list-group-item px-0 bg-transparent text-reset">
                                                                    <i class="fa fa-check text-success" role="img"></i>
                                                                    <t t-set="first_line" t-value="term.line_ids[:1]"/>
                                                                    <t t-if="first_line">
                                                                        <t t-set="downpayment"
                                                                           t-value="(total_inst_amount / 100.00) * first_line.value_amount"/>

                                                                        &#160;Downpayment
                                                                        <t t-esc="'%.2f' % downpayment"/>
                                                                        <t t-esc="currency_symbol"/>
                                                                    </t>
                                                                </li>
                                                                <li class="list-group-item px-0 bg-transparent text-reset o_default_snippet_text">
                                                                    <i class="fa fa-check text-success" role="img"></i>
                                                                    Account management
                                                                </li>
                                                                <li class="list-group-item px-0 bg-transparent text-reset">
                                                                    <i role="img" class="fa fa-check text-success"></i>&#160;24/7
                                                                    toll-free support&#160;
                                                                </li>
                                                            </ul>
                                                        </div>
                                                        <div class="card-footer text-center">
                                                            <p>
                                                                <b>Setup in minutes. Love it or get reimbursed</b>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <!-- Carousel controls (always visible, carousel stopped automatically) -->
                            <button class="carousel-control-prev" type="button" data-bs-target="#paymentTermsCarousel"
                                    data-bs-slide="prev" style="margin-left:-10%; opacity:1; filter: invert(1);">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#paymentTermsCarousel"
                                    data-bs-slide="next" style="margin-right:-10%; opacity:1; filter: invert(1);">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                </section>
            </xpath>
        </template>

        <template inherit_id="website_sale.product" id="product_start_now_btn" name="Start Now Button on Product Page">
            <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
                <t t-if="payment_terms">
                    <!-- No application yet: show Start Now -->
                    <t t-if="not partner_payment_term">
                        <div class="d-flex align-items-center mb-2 w-100">
                            <a role="button"
                               class="btn btn-primary w-100 text-center"
                               t-att-href="'/apply/' + str(payment_terms[:1].id) + '/' + str(product.id)">
                                <i class="fa fa-arrow-right me-2"/>
                                Start Now
                            </a>
                        </div>
                    </t>
                    <!-- Application in progress -->
                    <t t-if="partner_payment_term and partner_project_state in ('recieved', 'in_review', 'approved')">
                        <div class="d-flex align-items-center mb-2 w-100">
                            <a role="button"
                               class="btn btn-primary w-100 text-center"
                               t-att-href="'/shop/' + str(product.id)">
                                <i class="fa fa-spinner me-2"/>
                                Application Processing
                            </a>
                        </div>
                    </t>
                    <!-- Contract sent: Proceed to Checkout -->
                    <t t-if="partner_payment_term and partner_project_state == 'contract_sent'">
                        <div class="d-flex align-items-center mb-2 w-100">
                            <a role="button"
                               class="btn btn-primary w-100 text-center"
                               t-att-href="'/checkout/' + str(product.id) + '/' + str(partner_payment_term) + '/' + str(partner_line_id or 0)">
                                <i class="fa fa-check me-2"/>
                                Proceed to Checkout
                            </a>
                        </div>
                    </t>
                    <!-- Rejected: Submit Again -->
                    <t t-if="partner_payment_term and partner_project_state == 'reject'">
                        <div class="d-flex align-items-center mb-2 w-100">
                            <a role="button"
                               class="btn btn-primary w-100 text-center"
                               t-att-href="'/apply/' + str(partner_payment_term) + '/' + str(product.id)">
                                <i class="fa fa-refresh me-2"/>
                                Submit Application Again
                            </a>
                        </div>
                    </t>
                </t>
            </xpath>
        </template>

        <template inherit_id="website_sale.confirmation" id="website_sale_confirmation_downpayment">

            <xpath expr="(//td[@class='text-end pe-0' and @width='100'])[1]/strong"
                   position="replace">
                <t t-if="tx_sudo.sale_order_ids and tx_sudo.sale_order_ids[0].payment_term_id.line_ids">
                    <t t-set="down_percent"
                       t-value="tx_sudo.sale_order_ids[0].payment_term_id.line_ids[0].value_amount"/>
                    <t t-set="downpayment_amount"
                       t-value="(tx_sudo.sale_order_ids[0].amount_untaxed * down_percent) / 100"/>
                    <!-- check if current transaction amount equals downpayment -->
                    <t t-if="downpayment_amount != tx_sudo.sale_order_ids[0].amount_untaxed">
                        <strong>Downpayment:</strong>
                    </t>
                    <t t-else="">
                        <strong>Amount:</strong>
                    </t>
                </t>
            </xpath>
        </template>

        <!--        Removing Downpayment notification error-->
        <template inherit_id="website_sale.payment_confirmation_status" id="payment_confirmation_status_inherited">
            <xpath expr="//div/div/div/t[3]" position="replace">
                <span></span>
            </xpath>
            <xpath expr="//div/div/div/t[2]" position="replace">
                <t t-if="tx_sudo.state == 'done'">
                    <!-- compute downpayment -->
                    <t t-if="tx_sudo.sale_order_ids and tx_sudo.sale_order_ids[0].payment_term_id.line_ids">
                        <t t-set="down_percent"
                           t-value="tx_sudo.sale_order_ids[0].payment_term_id.line_ids[0].value_amount"/>
                        <t t-set="downpayment_amount"
                           t-value="(tx_sudo.sale_order_ids[0].amount_untaxed * down_percent) / 100"/>
                        <!-- check if current transaction amount equals downpayment -->
                        <t t-if="downpayment_amount != tx_sudo.sale_order_ids[0].amount_untaxed">
                            <span>Your downpayment has been successfully processed.</span>
                        </t>
                        <t t-else="">
                            <span t-if="tx_sudo.provider_id.sudo().done_msg"
                                  t-out="tx_sudo.provider_id.sudo().done_msg"/>
                        </t>
                    </t>
                    <!-- fallback if no payment term -->
                    <t t-else="">
                        <span t-if="tx_sudo.provider_id.sudo().done_msg"
                              t-out="tx_sudo.provider_id.sudo().done_msg"/>
                    </t>
                </t>
            </xpath>
        </template>

        <template id="address_kanban_inherit" inherit_id="website_sale.address_kanban"
                  name="Kanban address with Payment Term">
            <xpath expr="//div/div/t/a" position="replace">
                <a
                        t-att-href="new_address_href
                        + '&amp;partner_id=' + str(contact.id) 
                        + (website_sale_order.payment_term_id and '&amp;payment_term_id=' + str(website_sale_order.payment_term_id.id) or '')"
                        class="js_edit_address btn btn-link p-0 mt-auto"
                        role="button"
                        title="Edit this address"
                        aria-label="Edit this address">
                    <i class="fa fa-pencil me-1"/>Edit
                </a>
            </xpath>
        </template>

        <template id="address_row_inherit" inherit_id="website_sale.address_row" name="Address Row with Payment Term">
            <xpath expr="//div/div[2]/a" position="replace">
                <a
                        role="button"
                        t-att-href="new_address_href
                                + (order.payment_term_id and '&amp;payment_term_id=' + str(order.payment_term_id.id) or '')"
                        t-att-data-address-type="is_invoice and 'billing' or 'delivery'"
                        class="o_wsale_add_address d-flex align-items-center justify-content-center h-100 px-4 border rounded mx-auto no-decoration"
                >
                    <i class="fa fa-plus me-md-2"/>
                    <span class="d-none d-md-inline">Add address</span>
                </a>
            </xpath>
        </template>

        <template id="address_form_inherit_payment_term" inherit_id="website_sale.address"
                  name="Address form with Payment Term">
            <xpath expr="//form" position="inside">
                <!-- Preserve payment_term_id when submitting the form -->
                <input type="hidden" name="payment_term_id"
                       t-att-value="request.params.get('payment_term_id') or website_sale_order.payment_term_id.id or ''"/>
            </xpath>
        </template>

        <template id="product_custom_description_button" inherit_id="website_sale.product" >
            <xpath expr="//div[@id='o_product_terms_and_share']" position="after">
                <t t-if="product.product_blog_link">
                    <div class="d-flex align-items-center mb-2 w-auto">
                        <a role="button"
                            class="btn btn-primary w-auto text-center"
                            t-att-href="'/' + str(product.product_blog_link)"
                            target="_blank">
                            Description
                        </a>
                    </div>
                </t>
            </xpath>
        </template>

        <template id="auth_signup_login_inherit" inherit_id="auth_signup.login">
            <xpath expr="//p[@class='mt-2 text-center']/a[@t-if='signup_enabled']" position="replace">
                <!-- Don't have an account? button replaced -->
            </xpath>
        </template>

        <template id="web_login_inherit_custom" inherit_id="web.login">

            <xpath expr="//button[@type='submit' and contains(@class,'btn-primary')]" position="after">
                <button type="button"
                t-if="signup_enabled"
                class="btn mt-2"
                style="
                    background-color: #fd1c14;
                    color: white;
                    font-weight: 500;
                    border: none;
                "
                onclick="window.location.href='/web/signup' + window.location.search">
            Sign Up
        </button>
            </xpath>
        </template>

        <!-- <template id="payment_form_inherit" inherit_id="payment.form" name="Payment Form - Filtered">
            <xpath expr="//t[@t-foreach='payment_methods_sudo']" position="replace">
                <t t-foreach="payment_methods_sudo.filtered(lambda pm: pm.code != 'cod')" t-as="pm_sudo">
                    <li name="o_payment_option"
                        class="list-group-item d-flex flex-column gap-2 py-3 o_outline"
                    >
                        <t t-call="payment.method_form">
                            <t t-set="is_selected"
                               t-value="pm_sudo.id == selected_method_id"
                            />
                        </t>
                    </li>
                </t>
            </xpath>
        </template> -->
    </data>
</odoo>