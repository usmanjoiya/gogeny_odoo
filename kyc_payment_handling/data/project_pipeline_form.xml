<odoo>
    <!-- KYC Application form -->
    <template id="project_application_template" name="Project Application">
        <t t-call="website.layout">
            <div class="container py-5">
                <h2 class="mb-4">Applying for <t t-esc="product.name"/> on <t t-esc="payment_term.name"/></h2>
                <form id="applicationForm" action="/apply/submit" method="post" enctype="multipart/form-data" class="o_website_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="product_id" t-att-value="product.id"/>
                    <input type="hidden" name="term_id" t-att-value="payment_term.id"/>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <div class="row g-2">
                            <t t-set="full_name" t-value="request.env.user.partner_id.name or ''"/>
                            <t t-set="name_parts" t-value="full_name.split(' ')"/>
                            <div class="col-md-4">
                                <input type="text" name="first_name" required="True" class="form-control" placeholder="First Name"
                                    t-att-value="name_parts[0] if len(name_parts) > 0 else ''"/>
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="middle_name" class="form-control" placeholder="Middle Name"
                                    t-att-value="name_parts[1] if len(name_parts) == 3 or len(name_parts) > 3 else ''"/>
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="last_name" class="form-control" placeholder="Last Name"
                                    t-att-value="' '.join(name_parts[2:]) if len(name_parts) > 2 else (name_parts[1] if len(name_parts) == 2 else '')"/>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input type="text" name="phone_number" required="True" class="form-control"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Emergency Phone Number</label>
                                <input type="text" name="emergency_phone_number" required="True" class="form-control"/>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" required="True" class="form-control" t-att-value="request.env.user.partner_id.email or ''"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Place of Work</label>
                                <input type="text" name="place_of_work" required="True" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" name="street" class="form-control mb-2" placeholder="Street"/>
                        <input type="text" name="street2" class="form-control mb-2" placeholder="Street 2"/>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <input type="text" name="city" class="form-control" placeholder="City"/>
                            </div>
                            <div class="col-md-4">
                                <select name="state_id" class="form-select">
                                    <option value="">Select State</option>
                                    <t t-foreach="states" t-as="st">
                                        <option t-att-value="st.id"><t t-esc="st.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="zip" class="form-control" placeholder="ZIP"/>
                            </div>
                        </div>
                        <select name="country_id" class="form-select">
                            <option value="">Select Country</option>
                            <t t-foreach="countries" t-as="ct">
                                <option t-att-value="ct.id"><t t-esc="ct.name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">UAE ID Number</label>
                                <input type="text" name="uae_id_number" required="True" class="form-control"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Bank State Password(optional)</label>
                                <input type="password" name="bank_state_password" class="form-control"/>
                            </div>
                        </div>
                    </div>


<!--                    <div class="mb-3">-->
<!--                        <label class="form-label">UAE ID Number</label>-->
<!--                        <input type="text" name="uae_id_number" required="True" class="form-control"/>-->
<!--                    </div>-->
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">ID Photo Front</label>
                                <input type="file" name="id_photo_front" required="True" class="form-control"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">ID Photo Back</label>
                                <input type="file" name="id_photo_back" required="True" class="form-control"/>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">3M Bank Statement</label>
                                <input type="file" name="3m_bank_statement" required="True" class="form-control"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Salary Certificate</label>
                                <input type="file" name="salary_certificate" required="True" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Guaranteed Bank Cheque
                            <a class="ms-2 text-info" data-bs-toggle="collapse" href="#chequeSample" role="button"
                            aria-expanded="false" aria-controls="chequeSample">
                                <i class="bi bi-info-circle"></i>
                                View Sample
                            </a>
                        </label>
                        <input type="file" name="cheque_photo" required="True" class="form-control"/>
                        <div class="collapse mt-2" id="chequeSample">
                            <div class="card card-body text-center p-2" style="max-width: 300px; margin: 0 auto;">
                                <img src="/kyc_payment_handling/static/description/cheque_sample.png"
                                    alt="Sample Bank Cheque"
                                    class="img-fluid rounded border mb-1"
                                    style="max-height:100px; width:auto;"/>
                                <div class="form-text" style="font-size: 12px;">Sample Cheque</div>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Application</button>
                </form>
            </div>
        </t>
    </template>

    <!-- Show Installment details in cart under product -->
    <template id="cart_lines" inherit_id="website_sale.cart_lines" name="Shopping Cart Lines with Payment Terms">
        <xpath expr="//div[@id='cart_products']/div/t/div[2]" position="inside">
            <!-- Load all session terms -->
            <t t-set="cart_terms" t-value="request.session.get('apply_payment_terms', {})"/>
            <t t-set="line_terms" t-value="cart_terms.get(str(line.product_id.product_tmpl_id.id))"/>
            <!-- Extract ids -->
            <t t-set="term_id" t-value="line_terms.get('term_id') if line_terms else False"/>
            <t t-set="project_line_id" t-value="line_terms.get('project_line_id') if line_terms else False"/>
            <!-- Show payment term if exists -->
            <t t-if="term_id">
                <li class="list-group-item px-0 bg-transparent text-reset">
                    Payment Term: <t t-esc="request.env['account.payment.term'].browse(term_id).name"/>
                </li>
            </t>
        </xpath>
        <xpath expr="//div[@id='cart_products']/div/t/div[3]/div[1]" position="replace">
            <!-- Load all session terms -->
            <t t-set="cart_terms" t-value="request.session.get('apply_payment_terms', {})"/>
            <t t-set="line_terms" t-value="cart_terms.get(str(line.product_id.product_tmpl_id.id))"/>
            <!-- Extract ids -->
            <t t-set="term_id" t-value="line_terms.get('term_id') if line_terms else False"/>
            <t t-set="project_line_id" t-value="line_terms.get('project_line_id') if line_terms else False"/>
            <t t-if="term_id">
                <t t-set="got_any_line_term" t-value="True"/>
            </t>
            <!-- Show payment term if exists -->
            <t t-if="got_any_line_term">
                <div t-attf-class="css_quantity input-group mb-2"
                        name="website_sale_cart_line_quantity">
                    <t t-if="not line._is_not_sellable_line()">
                        <t t-if="show_qty">
                            <!-- <a href="#"
                                class="js_add_cart_json btn btn-link d-inline-block border-end-0"
                                aria-label="Remove one"
                                title="Remove one">
                                <i class="position-relative z-1 fa fa-minus"/>
                            </a> -->
                            <input type="text"
                                    readonly="True"
                                    class="js_quantity quantity form-control border-start-0 border-end-0"
                                    t-att-data-line-id="line.id"
                                    t-att-data-product-id="line.product_id.id"
                                    t-att-value="line._get_displayed_quantity()"/>
                            <!-- <t t-if="line._get_shop_warning(clear=False)">
                                <a href="#" class="btn btn-link">
                                <i class='fa fa-warning text-warning'
                                    t-att-title="line._get_shop_warning()"
                                    role="img"
                                    aria-label="Warning"/>
                                </a>
                            </t>
                            <a t-else=""
                                href="#"
                                class="js_add_cart_json d-inline-block float_left btn btn-link border-start-0"
                                aria-label="Add one"
                                title="Add one">
                                <i class="fa fa-plus position-relative z-1"/>
                            </a> -->
                        </t>
                        <!-- <t t-else="">
                            <input type="hidden"
                                    class="js_quantity form-control quantity"
                                    t-att-data-line-id="line.id"
                                    t-att-data-product-id="line.product_id.id"
                                    t-att-value="line._get_displayed_quantity()"/>
                        </t>
                    </t>
                    <t t-else="">
                        <span class="w-100 text-muted" t-esc="int(line.product_uom_qty)"/>
                        <input type="hidden"
                                class="js_quantity quantity form-control"
                                t-att-data-line-id="line.id"
                                t-att-data-product-id="line.product_id.id"
                                t-att-value="line._get_displayed_quantity()"/> -->
                    </t>
                </div>
            </t>
            <t t-else="">
                <div t-attf-class="css_quantity input-group mb-2"
                        name="website_sale_cart_line_quantity">
                    <t t-if="not line._is_not_sellable_line()">
                        <t t-if="show_qty">
                            <a href="#"
                                class="js_add_cart_json btn btn-link d-inline-block border-end-0"
                                aria-label="Remove one"
                                title="Remove one">
                                <i class="position-relative z-1 fa fa-minus"/>
                            </a>
                            <input type="text"
                                    class="js_quantity quantity form-control border-start-0 border-end-0"
                                    t-att-data-line-id="line.id"
                                    t-att-data-product-id="line.product_id.id"
                                    t-att-value="line._get_displayed_quantity()"/>
                            <t t-if="line._get_shop_warning(clear=False)">
                                <a href="#" class="btn btn-link">
                                <i class='fa fa-warning text-warning'
                                    t-att-title="line._get_shop_warning()"
                                    role="img"
                                    aria-label="Warning"/>
                                </a>
                            </t>
                            <a t-else=""
                                href="#"
                                class="js_add_cart_json d-inline-block float_left btn btn-link border-start-0"
                                aria-label="Add one"
                                title="Add one">
                                <i class="fa fa-plus position-relative z-1"/>
                            </a>
                        </t>
                        <t t-else="">
                            <input type="hidden"
                                    class="js_quantity form-control quantity"
                                    t-att-data-line-id="line.id"
                                    t-att-data-product-id="line.product_id.id"
                                    t-att-value="line._get_displayed_quantity()"/>
                        </t>
                    </t>
                    <t t-else="">
                        <span class="w-100 text-muted" t-esc="int(line.product_uom_qty)"/>
                        <input type="hidden"
                                class="js_quantity quantity form-control"
                                t-att-data-line-id="line.id"
                                t-att-data-product-id="line.product_id.id"
                                t-att-value="line._get_displayed_quantity()"/>
                    </t>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='cart_products']/div/t/div[2]/div" position="replace">
            <!-- Load all session terms -->
            <t t-set="cart_terms" t-value="request.session.get('apply_payment_terms', {})"/>
            <t t-set="line_terms" t-value="cart_terms.get(str(line.product_id.product_tmpl_id.id))"/>
            <!-- Extract ids -->
            <t t-set="term_id" t-value="line_terms.get('term_id') if line_terms else False"/>
            <t t-set="project_line_id" t-value="line_terms.get('project_line_id') if line_terms else False"/>
            <t t-if="term_id">
                <t t-set="got_any_line_term" t-value="True"/>
            </t>
            <!-- Show payment term if exists -->
            <t t-if="got_any_line_term">
                <div name="o_wsale_cart_line_button_container">

                </div>
            </t>
            <t t-else="">
                <div name="o_wsale_cart_line_button_container">
                    <a href='#'
                        class="js_delete_product d-none d-md-inline-block small"
                        aria-label="Remove from cart"
                        title="Remove from cart">Remove</a>
                    <button class="js_delete_product btn btn-light d-inline-block d-md-none"
                            title="remove">
                        <i class="fa fa-trash-o"/>
                    </button>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Show down-payment in cart under Total -->
    <template id="total" inherit_id="website_sale.total" name="Shopping Cart Total with Down Payment">
        <xpath expr="//div[@id='cart_total']/table/tr[@id='order_total']" position="after">
            <t t-if="website_sale_order.payment_term_id and website_sale_order.payment_term_id.line_ids">
                <t t-set="down_percent" t-value="website_sale_order.payment_term_id.line_ids[0].value_amount"/>
                <t t-set="downpayment_amount" t-value="(website_sale_order.amount_total * down_percent) / 100"/>
                <t t-if="downpayment_amount != website_sale_order.amount_total ">
                    <tr id="down_payment" class="border-top">
                        <td colspan="2" class="border-0 ps-0 pt-3">
                            <strong>Downpayment</strong>
                        </td>
                        <td class="text-end border-0 px-0 pt-3">
                            <strong t-esc="downpayment_amount"
                                t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"
                                class="monetary_field text-end p-0"/>
                        </td>
                    </tr>
                    <t t-if="downpayment_amount != website_sale_order.amount_untaxed and request.httprequest.path in ['/shop/payment']">
                        <tr id="downpayment_note" class="border-top">
                            <td colspan="4" style="font-size:13px" class="border-0 ps-0 pt-3">
                                <strong>Click on "Pay Now" to pay "Downpayment" Amount Only.</strong>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </xpath>

