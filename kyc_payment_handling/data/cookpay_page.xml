<odoo>
    <template id="cookpay_template" name="CookPay Page">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2>CookPay</h2>
                <form action="/cookpay/search" method="post" class="mt-3">
                    <div class="form-group">
                        <label for="customer_reference">Enter Customer Reference</label>
                        <input type="text" id="customer_reference" name="customer_reference"
                               class="form-control" required="required"/>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Search for unpaid Invoice</button>
                </form>

                <t t-if="error_message">
                    <div class="alert alert-danger mt-3">
                        <t t-esc="error_message"/>
                    </div>
                </t>

                <t t-if="partner_name">
                    <div class="mt-5">
                        <h4>Customer Name: <t t-esc="partner_name"/></h4>
                        <t t-if="invoices">
                            <table class="table table-bordered mt-3">
                                <thead>
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="invoices" t-as="inv">
                                        <tr>
                                            <td><t t-esc="inv['name']"/></td>
                                            <td><t t-esc="inv['amount']"/></td>
                                            <td><t t-esc="inv['state']"/></td>
                                            <td>
                                                <a t-att-href="inv['url']" class="btn btn-sm btn-info">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="not invoices">
                            <div class="alert alert-info mt-3">
                                No unpaid invoices found for this customer.
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
