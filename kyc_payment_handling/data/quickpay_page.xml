<odoo>
    <template id="quickpay_template" name="QuickPay Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <!-- Page Header -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">QuickPay</h2>
                    <p class="text-muted">Search unpaid invoices by entering your customer reference</p>
                </div>
                <!-- Search Form -->
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8 col-sm-10">
                        <form action="/quickpay/search" method="post" class="d-flex shadow-sm rounded overflow-hidden">
                            <input type="text" id="customer_reference" name="customer_reference"
                                   class="form-control border-0 py-3 px-3"
                                   placeholder="Enter Customer Reference..." required="required"/>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa fa-search me-1"></i> Search
                            </button>
                        </form>
                    </div>
                </div>
                <!-- Error Message -->
                <t t-if="error_message">
                    <div class="alert alert-danger mt-4 text-center shadow-sm">
                        <t t-esc="error_message"/>
                    </div>
                </t>
                <!-- Results -->
                <t t-if="partner_name">
                    <div class="card mt-5 shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title text-primary">
                                Customer: <span class="fw-bold"><t t-esc="partner_name"/></span>
                            </h4>
                            <!-- Invoices Table -->
                            <t t-if="invoices">
                                <div class="table-responsive mt-4">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Invoice</th>
                                                <th>Amount</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="invoices" t-as="inv">
                                                <tr>
                                                    <td><t t-esc="inv['name']"/></td>
                                                    <td class="fw-bold text-success">
                                                        <t t-esc="inv['amount']"/>
                                                    </td>
                                                    <td>
                                                        <span t-attf-class="badge rounded-pill
                                                            #{'bg-warning text-dark' if inv['state']=='draft' else
                                                              'bg-success' if inv['state']=='posted' else
                                                              'bg-secondary'}">
                                                            <t t-esc="inv['state']"/>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a t-att-href="inv['url']"
                                                           class="btn btn-sm btn-outline-primary">
                                                            View
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <!-- No Invoices -->
                            <t t-if="not invoices">
                                <div class="alert alert-info mt-4 text-center">
                                    <i class="fa fa-info-circle me-1"></i>
                                    No unpaid invoices found for this customer.
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>