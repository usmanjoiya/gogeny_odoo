<odoo>
    <record id="inherit_edit_project_form" model="ir.ui.view">
        <field name="name">inherit.project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_open_share_project_wizard']" position="after">
                <button name="action_state_in_review" string="Send for Review" type="object" class="oe_highlight"
                    invisible="state not in ['recieved']"/>
                <button name="action_state_approved" string="Approve" type="object" class="oe_highlight"
                    invisible="state not in ['in_review']"/>
                <button name="action_state_reject" string="Reject" type="object" class="oe_highlight"
                        invisible="state in ['reject']"/>
                <button name="action_send_contract" string="Send Contract" type="object" class="oe_highlight"
                        invisible="state not in ['approved']"/>
                <button name="action_resend_contract" string="Resend Contract" type="object" class="oe_highlight"
                        invisible="state not in ['contract_sent']"/>
            </xpath>

            <xpath expr="//form/sheet/group/group[1]/field[@name='partner_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//form/sheet/group/group[1]/field[@name='partner_id']" position="after">
                <field name="partner_id" widget="res_partner_many2one"/>
                <field name="phone" widget="phone"/>
                <field name="emergency_phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="place_of_work"/>
                <field name="uae_id_number"/>
                <field name="product_id"/>
                <field name="sale_order_id" readonly="True" force_save="True"/>
                <field name="invoice_ref_id" readonly="True" force_save="True"/>
            </xpath>
            <xpath expr="//form/sheet/group/group[2]/field[@name='user_id']" position="after">
                <field name="payment_term_id"/>
            </xpath>
            <xpath expr="//form/header/field[@name='stage_id']" position="attributes">
                <attribute name="options">{'clickable': False, 'fold_field': 'fold'}</attribute>
            </xpath>
            <xpath expr="//form/sheet/group/group[2]/field[@name='date']" position="after">
                <div class="o_address_format">
                    <field name="street" placeholder="Street..." class="o_address_street"/>
                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                    <field name="city" placeholder="City" class="o_address_city"/>
                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}"/>
                    <field name="zip_code" placeholder="ZIP" class="o_address_zip"/>
                    <div name="partner_address_country" class="d-flex justify-content-between">
                        <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='description']" position="before">
                <page string="Documents">
                    <group>
                        <group>
                            <field name="id_photo_front" filename="id_photo_front_filename" widget="binary"/>
                        </group>
                        <group>
                            <field name="id_photo_back" filename="id_photo_back_filename" widget="binary"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bank_statement" filename="bank_statement_filename" widget="binary"/>
                        </group>
                        <group>
                            <field name="salary_certificate" filename="salary_certificate_filename" widget="binary"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="cheque_photo" filename="cheque_photo_filename" widget="binary"/>
                        </group>
                        <group>
                            <field name="customer_signature" filename="customer_signature_filename" widget="binary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="inherit_view_project" model="ir.ui.view">
        <field name="name">inherit.project.project.list</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Client Name</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="attributes">
                <attribute name="string">Product Name</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="create_date" string="Application Date"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="partner_invoice_count" string="Previous Invoices" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>